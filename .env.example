# ─────────────────────────────────────────────────────────────
# iKON-BOT v2 environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Facebook session cookies from your login (ws3-fca). Single-line JSON array.
APPSTATE=[{"name":"c_user","value":"0000000000","domain":".facebook.com"},{"name":"xs","value":"YOUR_XS_TOKEN","domain":"facebook.com"}]

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ikon-bot?retryWrites=true&w=majority

# Groq API key — the bot's only AI provider, and what enables the 35 AI
# commands in module 8. Keys look like gsk_... and come from
# https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Leave blank to use bot/groq.js's own ladder, which starts at
# llama-3.3-70b-versatile and walks llama-3.1-8b-instant and the gpt-oss models
# if the first is unavailable to your key.
GROQ_MODEL=

# Server
PORT=3000
NODE_ENV=production

# Bot identity
BOT_NAME=iKON-BOT
OWNER=Aphecks iKon Klerk

# Comma separated Facebook numeric user ids allowed to use owner-only commands.
# Read from the environment only — nothing is hard-coded, so changing who is an
# admin is an env change plus a redeploy, not a code change. Leave this empty and
# every owner-only command (!ban, !eval, !reload, ...) refuses everyone.
ADMIN_IDS=1234567890,9876543210

# Optional shorthand for a single owner. Folded into ADMIN_IDS by
# bot/permissions.js, so set either one or both.
OWNER_ID=

# Messenger behaviour
# BOT_PREFIX is the recommended variable. PREFIX is accepted too, but on Linux it
# often already holds an install path, so a path-like value is ignored.
BOT_PREFIX=!
PREFIX=!
DEFAULT_COOLDOWN=5
REACTIONS_ENABLED=true
REACT_EMOJI=✅
MAINTENANCE_MODE=false

# Cache TTL in milliseconds
CACHE_TTL=300000
